# Copy to .env and fill in. NEVER commit .env.

# --- LLM ---
# Leave blank to let the SDK read ANTHROPIC_API_KEY from your environment.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5
MODERATOR_MODEL=claude-opus-5
# How hard the models think: low | medium | high | xhigh | max
EFFORT=high

# --- Data sources ---
# SEC EDGAR requires a descriptive User-Agent with contact info, or it blocks you.
SEC_USER_AGENT=AnalystDesk/0.1 (your.email@example.com)

# --- Storage ---
DATABASE_URL=sqlite:///./analyst_desk.db
CACHE_DIR=./data/cache
CACHE_TTL_HOURS=12

# --- Runtime ---
# When true, tools never hit the network and serve only cached data (offline demo mode).
DEMO_MODE=false
LOG_LEVEL=INFO
